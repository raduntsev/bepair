# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Только сервер (Vercel → Environment Variables). Никогда не в NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Напоминания утром и вечером: тот же секрет, что cron_secret в public.bp_server_config
CRON_SECRET=

# Web push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Нативный push (необязательно, см. README → «Приложения для iPhone и Android»)
FCM_SERVICE_ACCOUNT=
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.bepair.vpare
APNS_PRODUCTION=0
