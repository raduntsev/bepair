<?xml version="1.0" encoding="utf-8"?>
<!-- «Карта»: the two of you on a map, edge to edge, with one line over it.
     The map is a bitmap drawn by MapTiles.java from OpenStreetMap tiles; the text stays
     real text, so it is sharp and readable at any size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_map_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- The required attribution, always in view whatever the crop. -->
    <TextView
        android:id="@+id/widget_map_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_map_chip"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="@string/widget_map_attribution"
        android:textColor="@color/widget_ink_faint"
        android:textSize="8sp" />

    <LinearLayout
        android:id="@+id/widget_map_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:background="@drawable/widget_map_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_map_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_map_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_ink_faint"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_map_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- The pair as two characters, as on the other widgets (PairCharacters.java). -->
        <ViewFlipper
            android:id="@+id/widget_mark"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:autoStart="true"
            android:flipInterval="280"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/widget_mark_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </ViewFlipper>

        <TextView
            android:id="@+id/widget_map_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_map_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/widget_ink_faint"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
