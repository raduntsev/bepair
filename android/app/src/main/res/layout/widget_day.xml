<?xml version="1.0" encoding="utf-8"?>
<!-- «День», 2×2, after an iOS small widget: the pair as two characters at the top,
     the one sentence about today at the bottom in large type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- The pair as two characters acting out the day: eight frames the launcher flips
         on its own (PairCharacters.java). -->
    <ViewFlipper
        android:id="@+id/widget_mark"
        android:layout_width="84dp"
        android:layout_height="42dp"
        android:autoStart="true"
        android:flipInterval="280"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/widget_mark_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <ImageView
            android:id="@+id/widget_mark_7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
    </ViewFlipper>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="0.95"
        android:textColor="@color/widget_ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink_faint"
        android:textSize="13sp" />
</LinearLayout>
