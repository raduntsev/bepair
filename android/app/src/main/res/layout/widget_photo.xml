<?xml version="1.0" encoding="utf-8"?>
<!-- «Фото»: one of the couple's photos, edge to edge. The rounded background
     clips the picture on Android 12+; older launchers show it square. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_photo_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- The pair as two characters acting out the day: eight frames the launcher flips
             on its own (PairCharacters.java). -->
        <ViewFlipper
            android:id="@+id/widget_mark"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:autoStart="true"
            android:flipInterval="280"
            android:importantForAccessibility="no">
            <ImageView
                android:id="@+id/widget_mark_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/widget_mark_7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </ViewFlipper>

        <TextView
            android:id="@+id/widget_photo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
